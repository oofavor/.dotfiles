+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+typedef struct _SigfmInfo SigfmInfo;
+
+/* Extracts SIFT features from an 8-bit grayscale image, upscaled by @scale */
+SigfmInfo *sigfm_extract (const guint8 *pixels,
+                          int           width,
+                          int           height,
+                          int           scale);
+
+int        sigfm_keypoints_count (const SigfmInfo *info);
+
+GBytes    *sigfm_serialize (const SigfmInfo *info);
+
+SigfmInfo *sigfm_deserialize (GBytes *data);
+
+/* Number of geometrically consistent match pairs; 0 means no match */
+int        sigfm_match_score (const SigfmInfo *probe,
+                              const SigfmInfo *enrolled);
+
+void       sigfm_free (SigfmInfo *info);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (SigfmInfo, sigfm_free)
+
+G_END_DECLS
diff --git a/meson.build b/meson.build
index fe14ba0..28d989c 100644
--- a/meson.build
+++ b/meson.build
@@ -141,7 +141,7 @@ drivers_info = {
     'upeksonly': {},
     'upekts': {},
     'goodixmoc': {},
-    'goodix_gm168': { 'endian_dependent': true, 'helper': ['openssl'] },
+    'goodix_gm168': { 'endian_dependent': true, 'helper': ['openssl', 'sigfm'] },
     'nb1010': {},
     'fpcmoc': {},
     'realtek': {},
@@ -244,6 +244,25 @@ foreach i : driver_helpers
         endif
 
         optional_deps += openssl_dep
+    elif i == 'sigfm'
+        # SIGFM matcher (libfprint/sigfm) for image devices too small for NBIS.
+        # Only the needed OpenCV modules are linked: the pkg-config file lists
+        # every module and would leak them into the GIR scanner link.
+        opencv_pc = dependency('opencv4', version: '>= 4.5', required: false)
+        if not opencv_pc.found()
+            error('OpenCV is required for @0@'.format(driver))
+        endif
+        opencv_libdir = opencv_pc.get_variable(pkgconfig: 'libdir')
+        optional_deps += declare_dependency(
+            compile_args: ['-I' + opencv_pc.get_variable(pkgconfig: 'includedir')],
+            dependencies: [
+                cpp.find_library('opencv_core', dirs: opencv_libdir),
+                cpp.find_library('opencv_imgproc', dirs: opencv_libdir),
+                cpp.find_library('opencv_flann', dirs: opencv_libdir),
+                cpp.find_library('opencv_features2d', dirs: opencv_libdir),
+            ])
+
+        libfprint_conf.set10('HAVE_SIGFM', true)
     elif i == 'udev'
         install_udev_rules = true
 
