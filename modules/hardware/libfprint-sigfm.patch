+#ifdef HAVE_SIGFM
+/* SIGFM prints are FPI_PRINT_RAW holding an "aay": the SIGFM features of each
+ * touch (one for a scan, one per enroll stage for a template). The image is
+ * upscaled before SIFT, and touches with fewer keypoints are retried. */
+#define SIGFM_SCALE 2
+#define SIGFM_MIN_KEYPOINTS 30
+
+/* Same as the normalization done by a successful minutiae scan */
+static void
+sigfm_normalize_image (FpImage *image)
+{
+  gint w = image->width, h = image->height;
+  guint8 *d = image->data;
+
+  if (image->flags & FPI_IMAGE_H_FLIPPED)
+    for (gint y = 0; y < h; y++)
+      for (gint x = 0; x < w / 2; x++)
+        {
+          guint8 t = d[y * w + x];
+          d[y * w + x] = d[y * w + w - 1 - x];
+          d[y * w + w - 1 - x] = t;
+        }
+
+  if (image->flags & FPI_IMAGE_V_FLIPPED)
+    for (gint y = 0; y < h / 2; y++)
+      for (gint x = 0; x < w; x++)
+        {
+          guint8 t = d[y * w + x];
+          d[y * w + x] = d[(h - 1 - y) * w + x];
+          d[(h - 1 - y) * w + x] = t;
+        }
+
+  if (image->flags & FPI_IMAGE_COLORS_INVERTED)
+    for (gint i = 0; i < w * h; i++)
+      d[i] = 0xff - d[i];
+
+  image->flags &= ~(FPI_IMAGE_H_FLIPPED | FPI_IMAGE_V_FLIPPED | FPI_IMAGE_COLORS_INVERTED);
+}
+
+static gboolean
+fpi_print_add_from_image_sigfm (FpPrint *print, FpImage *image, GError **error)
+{
+  g_autoptr(SigfmInfo) info = NULL;
+  g_autoptr(GBytes) bytes = NULL;
+  GVariant *sample;
+
+  info = sigfm_extract (image->data, image->width, image->height, SIGFM_SCALE);
+  if (!info || sigfm_keypoints_count (info) < SIGFM_MIN_KEYPOINTS)
+    {
+      fp_dbg ("Too few SIGFM keypoints (%d)", info ? sigfm_keypoints_count (info) : -1);
+      g_propagate_error (error, fpi_device_retry_new (FP_DEVICE_RETRY_CENTER_FINGER));
+      return FALSE;
+    }
+
+  bytes = sigfm_serialize (info);
+  sample = g_variant_new_from_bytes (G_VARIANT_TYPE_BYTESTRING, bytes, TRUE);
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  g_object_set (print, "fpi-data",
+                g_variant_new_array (G_VARIANT_TYPE_BYTESTRING, &sample, 1), NULL);
+
+  return TRUE;
+}
+
+static void
+sigfm_add_samples (GVariantBuilder *builder, FpPrint *print)
+{
+  g_autoptr(GVariant) data = NULL;
+  GVariantIter iter;
+  GVariant *sample;
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("aay")))
+    return;
+
+  g_variant_iter_init (&iter, data);
+  while ((sample = g_variant_iter_next_value (&iter)))
+    {
+      g_variant_builder_add_value (builder, sample);
+      g_variant_unref (sample);
+    }
+}
+
+static void
+fpi_print_add_print_sigfm (FpPrint *print, FpPrint *add)
+{
+  GVariantBuilder builder = G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE ("aay"));
+
+  sigfm_add_samples (&builder, print);
+  sigfm_add_samples (&builder, add);
+  g_object_set (print, "fpi-data", g_variant_builder_end (&builder), NULL);
+}
+
+/* Best score of @probe's first sample against every sample of @template */
+static gint
+sigfm_print_score (FpPrint *template, FpPrint *probe)
+{
+  g_autoptr(GVariant) probe_data = NULL;
+  g_autoptr(GVariant) data = NULL;
+  g_autoptr(GVariant) probe_sample = NULL;
+  g_autoptr(GBytes) probe_bytes = NULL;
+  g_autoptr(SigfmInfo) probe_info = NULL;
+  FpiPrintType type;
+  GVariantIter iter;
+  GVariant *sample;
+  gint best = 0;
+
+  g_object_get (template, "fpi-type", &type, "fpi-data", &data, NULL);
+  g_object_get (probe, "fpi-data", &probe_data, NULL);
+  if (type != FPI_PRINT_RAW || !data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("aay")))
+    return 0;
+
+  probe_sample = g_variant_get_child_value (probe_data, 0);
+  probe_bytes = g_variant_get_data_as_bytes (probe_sample);
+  probe_info = sigfm_deserialize (probe_bytes);
+  if (!probe_info)
+    return 0;
+
+  g_variant_iter_init (&iter, data);
+  while ((sample = g_variant_iter_next_value (&iter)))
+    {
+      g_autoptr(GBytes) bytes = g_variant_get_data_as_bytes (sample);
+      g_autoptr(SigfmInfo) info = sigfm_deserialize (bytes);
+
+      if (info)
+        best = MAX (best, sigfm_match_score (probe_info, info));
+      else
+        fp_warn ("Skipping a damaged SIGFM sample");
+      g_variant_unref (sample);
+    }
+
+  return best;
+}
