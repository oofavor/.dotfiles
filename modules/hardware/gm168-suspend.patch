+/* Total time the system has spent suspended: CLOCK_BOOTTIME counts it,
+ * the monotonic clock does not. */
+static gint64
+gm168_suspended_us (void)
+{
+    struct timespec ts;
+
+    clock_gettime (CLOCK_BOOTTIME, &ts);
+    return (gint64) ts.tv_sec * G_USEC_PER_SEC + ts.tv_nsec / 1000 - g_get_monotonic_time ();
+}
