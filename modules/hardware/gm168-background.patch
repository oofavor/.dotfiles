+/* Init takes the background frames on the assumption that the sensor is
+ * empty. If the finger is already on it (the reader starts as the lid opens
+ * or the lock screen appears, which is when it gets touched) they hold the
+ * finger instead, and every image until fprintd exits is a ghost that passes
+ * the quality gate and matches nothing.
+ *
+ * A finger that was there during init fires the touch event as soon as
+ * polling starts (60 ms after arming in the logs, against 400 ms and up for
+ * a finger arriving at an empty sensor). So the first touch decides: early,
+ * and the last good background, kept in $GM168_STATE_DIR, replaces this one;
+ * late or never, and this one is good and becomes the kept one.
+ *
+ * @touched: called for a touch event rather than at deactivate.            */
+#define GM168_BG_SETTLE_US (500 * G_TIME_SPAN_MILLISECOND)
+
+static void
+gm168_background_judge (FpDeviceGoodixGm168 *self, gboolean touched)
+{
+    const gsize size = GM168_FRAME_PIXELS * sizeof (guint16);
+    const char *dir = g_getenv ("GM168_STATE_DIR");
+    g_autofree char *path = NULL;
+    g_autofree gchar *saved = NULL;
+    gsize len = 0;
+
+    if (!self->bg_pending || !self->background)
+        return;
+
+    if (dir && *dir)
+        path = g_build_filename (dir, "background.bin", NULL);
+
+    if (g_get_monotonic_time () - self->armed_us >= GM168_BG_SETTLE_US) {
+        g_autoptr(GError) err = NULL;
+
+        self->bg_pending = FALSE;
+        if (path && !g_file_set_contents (path, (const gchar *) self->background,
+                                          (gssize) size, &err))
+            fp_warn ("background: cannot save %s: %s", path, err->message);
+        return;
+    }
+
+    /* Deactivated before a finger on the sensor would have shown up. */
+    if (!touched)
+        return;
+
+    self->bg_pending = FALSE;
+    if (path && g_file_get_contents (path, &saved, &len, NULL) && len == size) {
+        fp_warn ("background: finger was on the sensor during init, using the saved one");
+        GM168_LOG_WARN (&self->log, "BG taken with a finger on the sensor, using the saved one");
+        g_free (self->background);
+        self->background = (guint16 *) g_steal_pointer (&saved);
+    } else {
+        fp_warn ("background: finger was on the sensor during init and none is saved, "
+                 "touches will not match until fprintd restarts");
+        GM168_LOG_WARN (&self->log, "BG taken with a finger on the sensor, none saved");
+    }
+}
+
 
